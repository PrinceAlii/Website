{
	"name": "ali-bonagdaran-site",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "biome check . && tsc --noEmit && next build"
	},
	"dependencies": {
		"next": "16.4.6",
		"next-themes": "0.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@tailwindcss/postcss": "4.3.5",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"wrangler": "4.162.0"
	}
}
