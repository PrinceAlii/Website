{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "website",
	"compatibility_date": "2026-11-16",
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/"]
	},
	"routes": [{ "pattern": "www.alib.au", "custom_domain": true }]
}
